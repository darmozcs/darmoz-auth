# Copiar a /opt/infra/services/darmoz-auth/.env en el servidor y completar.
# chmod 600 .env una vez completado (contiene secretos).

DARMOZ_AUTH_IMAGE=ghcr.io/darmozcs/darmoz-auth:latest
DARMOZ_AUTH_DOMAIN=darmozsc.duckdns.org
DARMOZ_AUTH_PATH_PREFIX=/auth
DARMOZ_AUTH_PORT=8080

# Postgres compartido (contenedor "postgres", red "data")
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/nexora
SPRING_DATASOURCE_USERNAME=nexora
SPRING_DATASOURCE_PASSWORD=nexora

# Llaves RSA montadas desde ./keys (ver compose.yaml)
JWT_PRIVATE_KEY_PATH=/app/keys/private_key.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public_key.pem
JWT_ISSUER=darmoz-auth
JWT_ACCESS_TOKEN_TTL_SECONDS=720
JWT_REFRESH_TOKEN_TTL_DAYS=30
